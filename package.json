{
    "name": "odd-one-out",
    "version": "0.0.0",
    "private": true,
    "description": "A small multiplayer color game drawn in text",
    "main": "backend/app.js",
    "scripts": {
        "start": "node backend/app.js",
        "watch": "node --watch-path=backend --watch-path=frontend backend/app.js",
        "dev:backend": "node --watch tools/dev-backend/index.js",
        "dev:frontend": "node --watch tools/dev-server/index.js",
        "dev:all": "node tools/dev-all/index.js",
        "dev:bots": "node tools/bots/index.js",
        "test": "node --test \"test/**/*.test.js\"",
        "lint": "biome check .",
        "format": "biome check --write .",
        "check": "pnpm lint && pnpm test",
        "og": "node tools/og/render.mjs",
        "screens": "node tools/screens/capture.mjs"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@12.5.1",
    "license": "PolyForm-Noncommercial-1.0.0",
    "dependencies": {
        "socket.io": "^4.8.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "playwright-core": "1.58.2",
        "socket.io-client": "^4.8.4"
    }
}
