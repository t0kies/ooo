# Every setting with its default, in .env format. Real environment variables
# take precedence over .env.
PORT=8080

# Page title, link preview and credit. Values with spaces are quoted.
SITE_NAME="Odd One Out"
SITE_DESCRIPTION="Spot the color that doesn't belong. Play solo, or race friends in quick matches."
SITE_AUTHOR="XOXN"
# Address used in link previews. Unset: the host the page was requested at.
# PUBLIC_URL=https://example.com

FEATURE_SOLO=true
FEATURE_QUICK_MATCH=true
FEATURE_INVITES=true

MATCH_SECONDS=35
STARTING_HEALTH=5
MIN_PLAYERS=2
MAX_PLAYERS=8
LOBBY_TIMEOUT_SECONDS=300
MIN_REACTION_MS=250
# Seconds running matches get to finish on shutdown
DRAIN_SECONDS=45
NICKNAME_MAX_LENGTH=20

# easy | normal | hard, with optional overrides
DIFFICULTY=normal
# DIFFICULTY_START_STEP=16
# DIFFICULTY_MIN_STEP=3
# DIFFICULTY_RAMP_ROUNDS=10

# Defaults to true when NODE_ENV=production
# REQUIRE_ORIGIN=true
# Header the proxy puts the client IP in (Railway: x-real-ip). Trusted only
# behind a proxy; without one, clients could spoof it to dodge the per-IP limits.
# CLIENT_IP_HEADER=x-real-ip
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=20
RATE_EVENTS_PER_WINDOW=30
RATE_CONNECTS_PER_WINDOW=30
RATE_WINDOW_SECONDS=10

# Read by Railway: how long it waits for the old deploy. At or above
# DRAIN_SECONDS, running matches finish before it stops.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
