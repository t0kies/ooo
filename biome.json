{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": ["**", "!**/node_modules", "!output", "!pnpm-lock.yaml"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "arrowParentheses": "asNeeded"
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noDuplicateProperties": "off"
            }
        }
    }
}
